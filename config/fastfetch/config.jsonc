{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/neco-arc.txt",
    "color": {
      "1": "magenta",
      "2": "cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 5
    }
  },
  "display": {
    "separator": " ✦ ",
    "color": {
      "keys": "magenta"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "at": "magenta",
        "host": "cyan"
      }
    },
    "separator",
    {
      "type": "os",
      "key": "󰍹 OS",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "󰆍 Shell",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "󰨇 WM",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "cyan",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "󰍛 GPU",
      "keyColor": "magenta",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "󰑭 Memory",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block"
    }
  ]
}
